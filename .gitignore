# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
# Kortex legacy workspace lives at /kortex/ (Rust + neuraldrive + tools).
# We track its source, but skip the upstream llama.cpp clone (974 MB) and
# all build artifacts. The /kortex/.gitignore handles target/ + node_modules/.
/kortex/llama.cpp/
/kortex/target/
/kortex/**/target/
/kortex/**/node_modules/
/kortex/**/dist/
/kortex/**/build/

# Inlined upstream workspaces (formerly nested git clones / orphan
# submodule gitlinks). We track the source so a fresh clone is complete,
# but every reproducible-from-source artifact is rebuilt locally.
/airi/node_modules/
/airi/**/node_modules/
/airi/dist/
/airi/**/dist/
/airi/dist-ssr/
/airi/**/dist-ssr/
/airi/.turbo/
/airi/**/.turbo/
/airi/.cache/
/airi/**/.cache/
/airi/.next/
/airi/**/.next/
/airi/.nuxt/
/airi/**/.nuxt/
/airi/**/target/

/claurst/**/node_modules/
/claurst/**/dist/
/claurst/**/dist-ssr/
/claurst/**/.turbo/
/claurst/**/.cache/
/claurst/**/.next/
/claurst/**/.nuxt/
/claurst/**/target/
/claurst/**/build/

/Qwen3-TTS/**/__pycache__/
/Qwen3-TTS/**/*.egg-info/
/Qwen3-TTS/**/.venv/
/Qwen3-TTS/**/build/
/Qwen3-TTS/**/dist/

antigravity-workflows/
open-antigravity/
vscodium/
antigravity/
claude-code-fork/

# External reference repositories cloned in for Kortex inference research.
# These ship as separate upstream projects and must NOT be committed here.
ds4/
geometry-of-consolidation/


# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
apikeys.txt

# API Keys — NEVER commit
api_keys.json
**/api_keys.json
.kortex/
**/.kortex/

# Rust
src-tauri/target/
src-tauri/zed/
native/
"config/api_keys.json"  
"src-tauri/config/api_keys.json"  
"*.env"  
