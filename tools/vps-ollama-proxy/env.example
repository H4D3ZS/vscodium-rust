# Copy on the VPS: cp env.example .env && nano .env
# Commit env.example with your team defaults; use .gitignore for .env if it diverges.

# Hostname only (no https://). Must be a name you control in DNS — NOT *.example.com (Let's Encrypt refuses it).
OLLAMA_DOMAIN=ai.cyberifrit.xyz

# Per-user entitlement gate (Netlify). nginx auth_request forwards the client's
# Supabase JWT here; returns 200 (allow) or 403 → 402 (not entitled).
CLOUD_AUTHZ_URL=https://cyberifrit.xyz/api/cloud-authorize
CLOUD_AUTHZ_HOST=cyberifrit.xyz

# Certbot ACME registration
LE_EMAIL=cyberifrit.dev@gmail.com

# Browser CORS allow-list. Space-separated; nginx reflects the matching one.
# Defaults cover: Tauri webview, GitHub Pages, and local Vite dev.
# Add any other end-user origins for the IDE (e.g. an MDM-pinned domain).
CORS_ORIGIN="https://h4d3zs.github.io tauri://localhost https://tauri.localhost http://localhost:5173 http://127.0.0.1:5173"

OLLAMA_UPSTREAM=http://127.0.0.1:11434
OLLAMA_PROXY_HOST=127.0.0.1:11434

# Per-IP rate limits. Defaults work for a single IDE seat behind one IP.
# Bump if your $200 customers run AIRI autonomy (many concurrent requests)
# or share a CG-NAT IP. Drop for a strict abuse-resistant public endpoint.
OLLAMA_RATE_PER_SEC=60
OLLAMA_BURST=120
OLLAMA_CONN_PER_IP=128
