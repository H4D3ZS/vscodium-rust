{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vscode-rust-app",
  "version": "0.1.0",
  "identifier": "com.hades.vscode-rust-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "vscode-rust-app",
        "url": "index.html",
        "width": 1024,
        "height": 768,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "additionalBrowserArgs": "--process-per-site --renderer-process-limit=1 --disable-features=SharedArrayBuffer --disable-gpu-shader-disk-cache"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:11434 https://*.gallery.vsassets.io https://open-vsx.org; script-src 'self' https://cdn.jsdelivr.net; worker-src 'self' blob: https://cdn.jsdelivr.net; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "ext-host/*"
    ]
  }
}