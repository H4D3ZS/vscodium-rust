{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-open",
    "dialog:allow-message",
    "core:window:allow-start-dragging",
    "shell:allow-spawn",
    "shell:allow-execute",
    "core:event:allow-listen",
    "core:event:allow-emit"
  ]
}